pipeline {
    agent any
    tools {
        maven 'Maven-3.6.3' 
    }
    stages {
        stage('Checkout Code') {
            steps {
                echo "1. CI: Pulling latest code from Git..."
                checkout scm
            }
        }
        stage('Build') {
            steps {
                echo "2. CI: Compiling the Java Application..."
                sh 'mvn clean compile'
            }
        }
        stage('Test') {
            steps {
                echo "3. CI: Running Unit Tests..."
                sh 'mvn test'
            }
        }
        stage('Package') {
            steps {
                echo "4. CI: Packaging the application..."
                sh 'mvn package -DskipTests'
            }
        }
    }
    post {
        success {
            echo "✅ CI SUCCESS: The code built and tested perfectly."
        }
    }
}
